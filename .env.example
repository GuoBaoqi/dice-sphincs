# 复制成 .env 后按需修改；.env 不进版本控制
APP_ENV=development

# 协议服务地址（OneBot 11 的 HTTP/反向 WS 端点）
# 本机开发：http://127.0.0.1:3000
# Compose 内：http://onebot:3000
ONEBOT_API_BASE=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=

# 本服务监听端口（OneBot 通过 HTTP POST / 或反向 WS 推送事件）
LISTEN_PORT=2483
LISTEN_HOST=0.0.0.0

# 机器人自身 QQ 号（从事件里也能拿到，这里作兜底）
BOT_QQ=

LOG_LEVEL=INFO